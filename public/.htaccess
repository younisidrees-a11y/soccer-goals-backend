<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonicalize both the host AND the scheme to one single URL. The host
    # half already existed (this server answers for any hostname pointed at
    # its IP - cPanel's default catch-all vhost behaviour - which meant
    # ns1.thesoccergoals.com, a nameserver subdomain never meant to serve
    # the site, was quietly serving an identical copy of every page and
    # getting indexed by Google as duplicate content). It never checked the
    # scheme though, so plain http://thesoccergoals.com (correct host,
    # wrong scheme) passed straight through un-redirected - confirmed live:
    # Google Search Console's "Crawled - currently not indexed" report
    # listed the same pages under http://, https://, and https://www.
    # variants, and a direct curl check showed http:// returning 200 with
    # no redirect at all while https://www. already correctly redirected.
    # Anything that isn't exactly https://thesoccergoals.com 301s here
    # before Laravel ever sees the request, so there's exactly one
    # indexable URL per page regardless of how it was reached.
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^thesoccergoals\.com$ [NC]
    RewriteRule ^(.*)$ https://thesoccergoals.com/$1 [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
