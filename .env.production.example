APP_NAME="The Soccer Goals"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database ---
# Matches the DB you created in step 3 of DEPLOYMENT.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thesoccergoals
DB_USERNAME=soccergoals
DB_PASSWORD=REPLACE-WITH-THE-PASSWORD-YOU-SET-IN-MYSQL

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Requires HTTPS to be working (step 8) before you flip this to true.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
# ^ Replace with a real SMTP provider (Postmark, SES, Mailgun, etc.) once you
#   need real emails (password resets, notifications) to actually send.

# --- Admin panel path ---
# This is the ONLY thing standing between your admin login and the public
# internet finding it by guessing /admin. Generate a fresh random one — do
# NOT reuse the value from local dev (it's been shown in chat this session).
# One way to generate one:
#   php -r "echo bin2hex(random_bytes(8));"
FILAMENT_PATH=REPLACE-WITH-A-FRESH-RANDOM-PATH

# --- AI match reports ---
# Used by `php artisan league:publish-results` and `php artisan
# results:update` to write a genuinely unique report per match via the
# Anthropic API. Get a key at https://console.anthropic.com (Settings > API
# Keys) - each report costs a small fraction of a cent with the Haiku model
# below. Leave blank and the commands still work, just falling back to the
# local template bank instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
